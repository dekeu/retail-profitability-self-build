      <column caption='Scenario Gross Profit' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_0494756246654976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0707992031014918] - [Calculation_0707992033329159]' />
      </column>
      <column caption='Scenario Gross Margin' datatype='real' default-format='p0.00%' name='[Calculation_0494756246786049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_0707992031014918]) &lt;&gt; 0 THEN&#10;SUM([Calculation_0494756246654976]) / SUM([Calculation_0707992031014918])&#10;END' />
      </column>
      <column caption='Gross Profit Change' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_0494756247191554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(&#10;    SUM([Calculation_0494756246654976]) - SUM([GROSS PROFIT]),&#10;    2&#10;)' />
      </column>
      <column caption='Margin Change (pp)' datatype='real' default-format='n&quot;pp&quot;#,##0.0;-&quot;pp&quot;#,##0.0' name='[Calculation_0494756247347203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 * ([Calculation_0494756246786049] - [Calculation_0707991976521728])' />
      </column>
      <column caption='Reset Value' datatype='integer' name='[Calculation_0494756255285252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Gross Margin' datatype='real' name='[Calculation_0707991976521728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([REVENUE]) &lt;&gt; 0 THEN SUM([GROSS PROFIT]) / SUM([REVENUE])&#10;END' />
      </column>
      <column caption='Selected Metric' datatype='real' name='[Calculation_0707991989821442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0707991989489665]&#10;WHEN &quot;Revenue&quot; THEN SUM([REVENUE])&#10;WHEN &quot;Gross Profit&quot; THEN SUM([GROSS PROFIT])&#10;END' />
      </column>
      <column caption='Scenario Revenue' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_0707992031014918]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[REVENUE] * (1 + [Parameters].[Parameter 0707992022224899] / 100) * (1 + [Parameters].[Parameter 0707992030785541] / 100)' />
      </column>
      <column caption='Scenario COGS' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_0707992033329159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[COGS] * (1 + [Parameters].[Parameter 0707992022790148] / 100) * (1 + [Parameters].[Parameter 0707992030785541] / 100)' />
      </column>
